MAMAKSCORE_MODE=offline
MAMAKSCORE_LLM_BASE_URL=https://provider.example/v1
MAMAKSCORE_LLM_API_KEY=replace-with-provider-key
MAMAKSCORE_LLM_MODEL=open-weight-model-id
MAMAKSCORE_VISION_MODEL=
MAMAKSCORE_EXPOSE_PROVISIONAL_CONFIDENCE=false
MAMAKSCORE_CONFIDENTIAL_PROCESSING_AUTHORIZED=false
MAMAKSCORE_CACHE_ENABLED=false
MAMAKSCORE_CACHE_PATH=.cache/replay.sqlite3
MAMAKSCORE_MAX_CONCURRENCY=2
MAMAKSCORE_QUEUE_WAIT_SECONDS=0.25
MAMAKSCORE_PROVIDER_TIMEOUT_SECONDS=45
MAMAKSCORE_REQUEST_TIMEOUT_SECONDS=55
